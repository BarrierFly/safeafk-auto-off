{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",

  "name": "${name}",
  "description": "Automatically disables TweakerMore's safe AFK feature when it triggers, and reminds you on next join.",
  "authors": [
  ],
  "contact": {
    "homepage": "https://github.com/"
  },
  "license": "LGPL-3.0",

  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.safeafkautooff.SafeAfkAutoOffMod"
    ]
  },
  "mixins": [
    "safeafk-auto-off.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.11.4",
    "minecraft": "${minecraft_dependency}",
    "tweakermore": "*"
  }
}
